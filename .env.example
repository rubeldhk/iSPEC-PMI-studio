# Copy to .env for local development. Never commit .env (see .gitignore).

# Host ports. Override if these are already in use on your machine.
PMI_POSTGRES_PORT=5432
PMI_VALKEY_PORT=6379

DATABASE_URL=postgresql://pmi:pmi_local_dev@localhost:5432/pmi_studio
VALKEY_URL=redis://localhost:6379

# AI provider credential for the engine sandbox (ADR-0002).
# The ONLY credential passed into a sandbox container. Never commit it.
#
# `pnpm v6:real-run` loads this file (--env-file-if-exists) and passes the value
# through `composeEngineRegistry`, which falls back to process.env. An EMPTY value
# is not the same as an absent one to the shell, but it is to the engine: the
# sandbox refuses to start either way, with
# "Refusing to start a sandbox without an AI provider credential."
AI_PROVIDER_TOKEN=
