# Copy to .env for local development. Never commit .env (see .gitignore).

# Host ports. Override if these are already in use on your machine.
PMI_POSTGRES_PORT=5432
PMI_VALKEY_PORT=6379

DATABASE_URL=postgresql://pmi:pmi_local_dev@localhost:5432/pmi_studio
VALKEY_URL=redis://localhost:6379

# AI provider credential for the engine sandbox (ADR-0002).
# The ONLY credential passed into a sandbox container. Never commit it.
#
# `pnpm v6:real-run` loads this file (--env-file-if-exists) and passes the value
# through `composeEngineRegistry`, which falls back to process.env. An EMPTY value
# is not the same as an absent one to the shell, but it is to the engine: the
# sandbox refuses to start either way, with
# "Refusing to start a sandbox without an AI provider credential."
AI_PROVIDER_TOKEN=

# ---------------------------------------------------------------------------
# Engineering Experts — the agent runtime (EPIC-047 DEF-047-002, ADR-0030).
# Read by api-launcher/, the API's composition root, and nowhere in backend/.
#
# PMI_EXPERT_MODELS  the models an Expert may be dispatched to, comma-separated.
#                    One agent gateway is composed per model; a contract naming
#                    a model not listed here is refused, never substituted.
#                    Empty: only the fixture agent (model fixture-1).
# PMI_EXPERT_IMAGE   the sandbox image an Expert run executes in. Empty: the
#                    engine image (pmi-studio/speckit-engine), which carries the
#                    agent CLI. Runs also need a reachable Docker daemon and the
#                    pmi-egress-generation network (`node scripts/egress-proxy-up.mjs generation`).
PMI_EXPERT_MODELS=
PMI_EXPERT_IMAGE=

# ---------------------------------------------------------------------------
# Local project workspace (EPIC-041, PMI-DOC-007). Six variables, asserted by
# tests/governance/projects-root-config.spec.ts (T1310).
#
# PMI_PROJECTS_ROOT       where the API writes project directories. In the
#                         reference-local stack this is a directory on your
#                         machine; in the containerised stack it is /projects,
#                         which docker-compose.yml mounts from the host root.
# PMI_PROJECTS_ROOT_HOST  the same directory as YOUR machine sees it. Stored on
#                         each project and shown on every screen. Equal to
#                         PMI_PROJECTS_ROOT when the API runs on the host.
# Fill both in; the example deliberately names no path on anyone's machine.
PMI_PROJECTS_ROOT=
PMI_PROJECTS_ROOT_HOST=

# The address the developer's machine reaches this PMI Studio at. Written into
# .pmi/project.json and .mcp.json; a container cannot infer it.
PMI_PUBLIC_URL=http://localhost:3000

# The Spec Kit release the worker initialises a directory with (R-041-8). The
# same tag the engine image pins. Keep the leading v — that is how the release
# tags are spelled.
PMI_ENGINE_TAG=v0.16.4

# The @pmi/mcp-server version written into .mcp.json (EPIC-043 ships it).
PMI_MCP_SERVER_VERSION=0.1.0

# How long a prepared project waits for a worker to claim its initialise job
# before it reads "initialisation pending" and the setup skill takes over.
PMI_INITIALISE_WAIT_MS=30000

# The agent integration and script type a project gets when its creator chooses
# neither (FR-LPW-005). Leave the integration empty to use the workspace
# bundle's default; the script type must be sh or ps.
PMI_DEFAULT_AGENT_INTEGRATION=
PMI_DEFAULT_SCRIPT_TYPE=sh

# Development only: run the pmi-studio MCP server from THIS checkout instead of
# the published @pmi/mcp-server package. A full command line, e.g.
#   node ./packages/mcp-server/dist/main.js
# Leave empty (the default, and the only value the containerised stack uses) to
# have .mcp.json run npx -y @pmi/mcp-server@<PMI_MCP_SERVER_VERSION>.
PMI_MCP_SERVER_COMMAND=

# ---------------------------------------------------------------- artifacts
#
# EPIC-045 T1645 — the limits the artifact sync applies to ONE file and to one
# sync. Both are read once from the environment; both refuse PER FILE, never
# per sync, so a single oversized or over-numerous file costs that file and
# nothing else.
#
# PMI_ARTIFACT_MAX_BYTES   the largest a single synced markdown file may be,
#                          measured in UTF-8 bytes. Default 1048576 (1 MiB).
#                          A file above it is refused with `too_large`, and the
#                          finish hook prints that refusal beside the paths it
#                          did store — the command still completes.
PMI_ARTIFACT_MAX_BYTES=1048576

# PMI_ARTIFACT_MAX_FILES   how many files one sync may carry. Default 200.
#                          The file PAST the limit is refused with
#                          `too_many_files`; the ones before it are stored, so
#                          raising the limit and running the command again
#                          fills in the rest.
PMI_ARTIFACT_MAX_FILES=200

# PMI_ARTIFACT_SYNC_BODY_BYTES  the API's request-body limit, in bytes. Default
#                          16777216 (16 MiB). The finish hook sends an Epic's
#                          whole markdown set in ONE request, so this must hold
#                          the set, not one file. A body above it is refused
#                          whole as `413 payload_too_large` (DEF-045-001).
PMI_ARTIFACT_SYNC_BODY_BYTES=16777216

# EPIC-046 T1759 — the task board's four settings. The first two refuse the
# WHOLE sync (a file the platform cannot read at all is not partially read);
# the last two govern one line each, so a line that breaks them is refused and
# reported while the rest of the file syncs.
#
# PMI_TASKS_MAX_BYTES      the largest a `tasks.md` may be, in UTF-8 bytes.
#                          Default 1048576 (1 MiB), which sits well inside
#                          PMI_ARTIFACT_SYNC_BODY_BYTES above — the finish hook
#                          sends the Epic's whole markdown set in one request.
#                          A file above it refuses the sync with `file_too_large`.
PMI_TASKS_MAX_BYTES=1048576

# PMI_TASKS_MAX_LINES      how many CONSIDERED task lines one file may carry.
#                          Default 1000. Above it the sync refuses with
#                          `too_many_task_lines` and no row is written, so the board
#                          keeps the parse it already had rather than half of a
#                          new one.
PMI_TASKS_MAX_LINES=1000

# PMI_TASK_ID_PATTERN      the identifier shape a ticked line must carry, as a
#                          regular expression. Defaults to the repository's own
#                          shape from governance/epic-stage.config.json (`T\d+`)
#                          — this overrides that default, it does not define it
#                          (FR-ESK-025). A line whose token does not match is
#                          refused `identifier_not_matched` and listed under
#                          Refused lines; nothing is guessed from it.
# PMI_TASK_ID_PATTERN=^T\d+$

# PMI_TASK_DESCRIPTION_MAX the longest description one task line may carry, in
#                          characters. Default 500. A longer line is refused
#                          `description_too_long` — a description that runs to a
#                          paragraph is a heading someone ticked, not a task.
PMI_TASK_DESCRIPTION_MAX=500

# --- EPIC-039 Integration Hub (R-039-8, R-039-10, R-039-6, FR-HUB-084) ------

# PMI_ENVIRONMENT          the platform's deployment environment: local, dev,
#                          stage or prod (Constitution VII). REQUIRED — the
#                          integrations module refuses to start without it,
#                          naming it, rather than guessing `prod` or `local`. A
#                          project's adapter configuration may be permitted in
#                          only some of these (`permittedEnvironments`).
PMI_ENVIRONMENT=local

# PMI_INTEGRATION_KEYS     JSON object of platform keys that encrypt adapter
#                          credentials at rest (AES-256-GCM): { "<keyId>":
#                          "<base64 of 32 random bytes>" }. Generate a key with
#                          `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
#                          Unset = no keyring: credential writes answer 503 naming
#                          CredentialKeyring, and nothing is ever stored in clear.
#                          Rotation: add a key and make it active; old rows still
#                          decrypt by their keyId.
# PMI_INTEGRATION_KEYS={"k1":"<base64-32-bytes>"}

# PMI_INTEGRATION_ACTIVE_KEY  the keyId new credentials are encrypted with.
# PMI_INTEGRATION_ACTIVE_KEY=k1

# PMI_INTEGRATION_SCHEDULER  `off` disables the periodic adapter health check
#                          (every test sets it); `manual` lets a route test drive
#                          the job handler. Anything else, or unset, runs it
#                          every 30 s: at most 50 checks per tick, concurrency 4.
PMI_INTEGRATION_SCHEDULER=on

# PMI_EMBED_ADAPTER        the deployment's Embed binding (FR-HUB-084): the
#                          catalog key of the adapter EPIC-038's EmbeddingPort is
#                          resolved to — `ollama-embed` or `fixture-embed`. Read
#                          and recorded at boot; NO route and no workspace grant
#                          can change it. Unset = unbound: embedding refuses with
#                          the Hub's explanation. Switching takes effect on restart
#                          and is recorded, with reindexRequired when the model
#                          changed.
# PMI_EMBED_ADAPTER=ollama-embed

# PMI_EMBED_BINDING        JSON, the bound adapter's non-secret binding. For
#                          ollama-embed: { "baseUrl": "http://127.0.0.1:11434",
#                          "model": "nomic-embed-text" } (listed models:
#                          nomic-embed-text 768, all-minilm 384,
#                          mxbai-embed-large 1024). A secret-looking value is
#                          refused at boot.
# PMI_EMBED_BINDING={"baseUrl":"http://127.0.0.1:11434","model":"nomic-embed-text"}
#
# PMI_EMBED_PERMIT_DEGRADED  EPIC-039 T2624 (FR-HUB-026). Only a healthy Embed
#                          binding is eligible by default; set to true to let
#                          a degraded one (e.g. throttled) still serve
#                          EmbeddingPort. Unset means healthy only.
# PMI_EMBED_PERMIT_DEGRADED=true
