// T012 + T013 — Workspace, User, universal columns, and the structural tables
// EPIC-001's job orchestration depends on.
//
// Design source: specs/_shared/schema.sql and specs/_shared/data-model.md
//
// FR-002: every tenant-scoped model carries workspaceId from the FIRST
// migration, so Phase 3 row-level security is a switch rather than a data
// migration. Scoping is applied by a helper (T014), never by hand at call sites.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  projects              Project[]
  generationJobs        GenerationJob[]
  auditEntries          AuditEntry[]
  requirements          Requirement[]
  requirementVersions   RequirementVersion[]
  specifications        Specification[]
  specificationVersions SpecificationVersion[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(uuid())
  workspaceId  String
  email        String   @unique
  displayName  String
  // Argon2id. Never selected by a read path. Hashing itself is EPIC-005.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("users")
}

// ---------------------------------------------------------------- projects
//
// T053 (EPIC-006) — ownership taken 2026-08-20, the day PMI-DOC-004 v1.0
// discharged the D-10 hold. Until then this was EPIC-001's structural stub;
// the behavioural columns below are exactly the set the stub deliberately
// withheld (FR-001, FR-019).
//
// `engineName` is the per-project engine selection (FR-019): null means
// inherit the deployment default, which is `EngineResolverService`'s existing
// contract — `ProjectEngineSelectionPort` returns null to inherit. A name
// rather than an id, matching `GenerationJob.engineName` and the registry,
// which keys engines by name.

enum ProjectStatus {
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus @default(active)
  // FR-019: null = inherit the registered default engine.
  engineName  String?
  ownerUserId String
  // FR-001: archive is a status, never a delete. Content is preserved intact.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  generationJobs GenerationJob[]
  requirements   Requirement[]
  specifications Specification[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("projects")
}

// ---------------------------------------------------------------- requirements
//
// T064 (EPIC-007) — the head of the traceability chain (FR-004 to FR-009).
//
// Indexes on (projectId, type/priority/status): FR-008 is a list operation on
// a register that grows with the project, and SC-009's 1-second p95 applies to
// listing views — filtered reads must be indexed, not scanned.

enum RequirementType {
  business
  functional
  non_functional
  constraint
}

enum RequirementPriority {
  p1
  p2
  p3
}

enum RequirementStatus {
  active
  retired
}

model Requirement {
  id          String              @id @default(uuid())
  workspaceId String
  projectId   String
  // FR-005: human-facing identifier, unique within the project.
  reference   String
  // FR-007: required non-empty — refused with the field named, and a CHECK
  // constraint in the migration backs the service-level refusal.
  description String
  type        RequirementType
  priority    RequirementPriority
  status      RequirementStatus   @default(active)
  // FR-032 seam to EPIC-008: detects material change for out-of-date flagging.
  contentHash String
  // FR-006: soft retire, never delete.
  retiredAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  project   Project              @relation(fields: [projectId], references: [id])
  versions  RequirementVersion[]

  @@unique([projectId, reference])
  @@index([workspaceId])
  @@index([projectId, type])
  @@index([projectId, priority])
  @@index([projectId, status])
  @@map("requirements")
}

// FR-009: append-only edit history. No update or delete path exists in code,
// and the database rejects both via the `requirement_versions_immutable`
// trigger (T458, attached to EPIC-004's shared `reject_mutation()`).
model RequirementVersion {
  id            String              @id @default(uuid())
  workspaceId   String
  requirementId String
  // The text as it stood (data-model.md): prior state, retrievable forever.
  description   String
  type          RequirementType
  priority      RequirementPriority
  authoredById  String
  authoredAt    DateTime            @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  requirement Requirement @relation(fields: [requirementId], references: [id])

  @@index([workspaceId])
  @@index([requirementId, authoredAt(sort: Desc)])
  @@map("requirement_versions")
}

// ---------------------------------------------------------------- specifications
//
// T077 (EPIC-008) — the generated artifact and its immutable version history
// (FR-010, FR-012, FR-013, FR-022, FR-032).
//
// Both raw and parsed engine output are stored (R-007). An AI agent's output is
// prose against a template, not a guaranteed schema: storing only the parsed
// form makes any future parser bug permanent data loss, because re-deriving it
// would mean paying for the engine run again.
//
// `engineName` + `engineVersion` rather than the design DDL's `engine_id` FK —
// the same T012a convention EPIC-007 recorded: schema.prisma is authoritative
// at implementation, the design DDL is design-level. A name matches
// `GenerationJob.engineName`, `Project.engineName`, and the registry, which
// keys engines by name. Neither column is nullable, which is what makes FR-022
// checkable rather than assumed (T082).
//
// The lifecycle STATE lives here because a specification always has one; the
// transition rules and the `LifecycleTransition` record are EPIC-009 (T099,
// T109). Storing a state is not the same as owning the machine that moves it.

enum SpecLifecycleState {
  draft
  review
  approved
  baselined
  implemented
  archived
}

model Specification {
  id               String             @id @default(uuid())
  workspaceId      String
  // FR-010: exactly one project. Singular by construction — a list here would
  // make the requirement unenforceable at the schema.
  projectId        String
  title            String
  lifecycleState   SpecLifecycleState @default(draft)
  currentVersionId String?            @unique
  // FR-022: engine identity, never null. Version identifies BOTH tool and
  // model (R-001) — same engine, different model is a different version.
  engineName       String
  engineVersion    String
  generatedAt      DateTime
  // FR-032: set when a source requirement changes; NEVER auto-corrected, and
  // never a trigger to regenerate. A human decides.
  isOutOfDate      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  createdById      String
  updatedAt        DateTime           @updatedAt
  updatedById      String

  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  project        Project                @relation(fields: [projectId], references: [id])
  versions       SpecificationVersion[] @relation("SpecificationVersions")
  currentVersion SpecificationVersion?  @relation("SpecificationCurrentVersion", fields: [currentVersionId], references: [id])

  @@index([workspaceId])
  // SC-009's 1-second p95 applies to listing views, and the list is filtered by
  // lifecycle state — so the filtered read is indexed, not scanned.
  @@index([projectId, lifecycleState])
  @@map("specifications")
}

// FR-013 / SC-007: immutable snapshots, append-only. No update or delete path
// exists in code; the database rejects both via the
// `specification_versions_immutable` trigger — EPIC-009 T460, attached to
// EPIC-004's shared `reject_mutation()`.
model SpecificationVersion {
  id                       String             @id @default(uuid())
  workspaceId              String
  specificationId          String
  versionNumber            Int
  // R-007: the engine's output VERBATIM, always kept.
  contentRaw               String
  contentParsed            Json
  lifecycleStateAtCreation SpecLifecycleState
  // FR-014: who, and when.
  authoredById             String
  authoredAt               DateTime           @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  specification Specification  @relation("SpecificationVersions", fields: [specificationId], references: [id])
  currentOf     Specification? @relation("SpecificationCurrentVersion")

  @@unique([specificationId, versionNumber])
  @@index([workspaceId])
  @@index([specificationId, versionNumber(sort: Desc)])
  @@map("specification_versions")
}

// ---------------------------------------------------------------- jobs

enum JobKind {
  generate_specification
  generate_tasks
  validate_specification
}

enum JobState {
  queued
  running
  succeeded
  failed
  cancelled
  timed_out
}

// FR-026 / SC-005: there is deliberately no `unknown` member.
enum JobFailureReason {
  engine_unavailable
  engine_error
  malformed_output
  empty_output
  timeout
  cancelled
  input_too_large
  empty_selection
}

model GenerationJob {
  id             String            @id @default(uuid())
  workspaceId    String
  projectId      String
  // Idempotency: a duplicate submission joins the existing job rather than
  // starting — and billing — a second engine run.
  jobKey         String
  kind           JobKind
  requestedById  String
  engineName     String
  engineVersion  String
  // Correlation identifier, carried API -> queue -> worker -> sandbox (PC-3).
  correlationId  String
  inputRefs      Json
  state          JobState          @default(queued)
  failureReason  JobFailureReason?
  // T845 (EPIC-008) — the artifact a succeeded job produced. Null until there
  // is one, and null forever on a job that failed, was cancelled, or timed out:
  // there is nothing to point at (FR-027, SC-006). Written in the same
  // transaction as the specification itself.
  resultRef      String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])

  // Only one LIVE job per idempotency key. Enforced in the migration as a
  // partial unique index over state IN ('queued','running').
  @@index([projectId, jobKey])
  @@index([projectId, createdAt])
  @@index([workspaceId])
  @@map("generation_jobs")
}

// ---------------------------------------------------------------- audit

enum AuditAction {
  create
  update
  lifecycle_transition
  engine_invocation
  access_refused
}

enum AuditOutcome {
  success
  refused
  failed
}

// FR-033 / SC-012. Append-only: no update or delete path exists in code, and
// a database trigger rejects UPDATE and DELETE (see specs/_shared/schema.sql).
model AuditEntry {
  id          String       @id @default(uuid())
  workspaceId String
  // Null ONLY for unauthenticated refusals — the events most worth recording.
  actorId     String?
  action      AuditAction
  targetType  String
  targetId    String?
  outcome     AuditOutcome
  detail      Json?
  occurredAt  DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_entries")
}

// ---------------------------------------------------------------- engines
//
// T034 — the engine set a deployment accepted at startup.
//
// NOT tenant-scoped, so no workspaceId: an engine is a property of the
// deployment, not of a customer. FR-002's universal-column rule applies to
// tenant-scoped models; recording the exception here rather than leaving a
// reader to wonder whether it was forgotten.
//
// This table is a RECORD, not the source of truth. Adapters are supplied at the
// composition root (worker/src/engine-composition.ts) and validated there
// (FR-021); rows here exist so an operator can see which engines a running
// deployment accepted, and at what version, without reading the code.
//
// Per-project engine SELECTION is deliberately absent. The Project stub must
// not grow before EPIC-006 owns it, and EPIC-006 owns selection — so
// EngineResolverService reads it through a port that EPIC-006 will implement.

model EngineRegistration {
  id           String   @id @default(uuid())
  name         String   @unique
  // Identifies BOTH tool and model (FR-022, E10). Same Spec Kit + different
  // model is a different version, because the output differs.
  version      String
  capabilities String[]
  isDefault    Boolean  @default(false)
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("engine_registrations")
}
