// T012 + T013 — Workspace, User, universal columns, and the structural tables
// EPIC-001's job orchestration depends on.
//
// Design source: specs/_shared/schema.sql and specs/_shared/data-model.md
//
// FR-002: every tenant-scoped model carries workspaceId from the FIRST
// migration, so Phase 3 row-level security is a switch rather than a data
// migration. Scoping is applied by a helper (T014), never by hand at call sites.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

// EPIC-019 T226 — the scope above workspace (R-017-1). `organizationId` goes
// on `workspaces` ONLY: every artifact reaches its organization by one join,
// and a second denormalised tenancy column would be a second thing to get
// wrong in a security boundary.
model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@map("organizations")
}

model Workspace {
  id             String   @id @default(uuid())
  name           String
  // Required — a workspace belongs to exactly one organization. The default
  // points at the seeded default organization so pre-organization callers
  // (and every seed written before this epic) stay valid (T227).
  organizationId String   @default("org_default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Restrict, not Cascade: deleting an organization that still has
  // workspaces is refused (T225).
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  users                 User[]
  projects              Project[]
  generationJobs        GenerationJob[]
  auditEntries          AuditEntry[]
  requirements          Requirement[]
  requirementVersions   RequirementVersion[]
  specifications        Specification[]
  specificationVersions SpecificationVersion[]
  traceabilityLinks     TraceabilityLink[]
  decisionRecords       ArchitectureDecisionRecord[]
  lifecycleTransitions  LifecycleTransition[]
  validationFindings    ValidationFinding[]
  tasks                 Task[]
  steeringScopes        SteeringScope[]
  steeringDocuments     SteeringDocument[]
  steeringApplications  SteeringApplication[]
  dependencyEdges       DependencyEdge[]
  reviewGates           ReviewGate[]
  gateOutcomes          GateOutcome[]
  reviewFindings        ReviewFinding[]
  runs                  Run[]
  recordedQuestions     RecordedQuestion[]
  provisionalMarkings   ProvisionalMarking[]
  provisionalOverrides  ProvisionalApprovalOverride[]
  reviewSessions        ReviewSession[]
  answers               Answer[]
  accessGrants          AccessGrant[]
  accessAttempts        AccessAttemptRecord[]
  storageConnections    StorageConnection[]
  publishRecords        PublishRecord[]
  publishedFiles        PublishedFileReference[]
  loopConfigurations    LoopInstanceConfiguration[]
  loopObjects           LoopObject[]
  loopTransitions       LoopTransition[]
  requirementCandidates RequirementCandidate[]
  requirementDecisions  RequirementDecision[]
  baselines             Baseline[]
  adjudicationRecords AdjudicationRecord[]
  applicationIntents  ApplicationIntent[]
  connectorRegistrations ConnectorRegistration[]
  principals             Principal[]
  principalStateEvents   PrincipalStateEvent[]
  principalSnapshots     PrincipalIdentitySnapshot[]
  principalDelegations   PrincipalDelegation[]
  executions             Execution[]
  executionEvents        ExecutionEvent[]
  gateFinalOutcomes   GateFinalOutcome[]
  applicationPolicies ApplicationPolicy[]


  @@map("workspaces")
}

model User {
  id           String   @id @default(uuid())
  workspaceId  String
  email        String   @unique
  displayName  String
  // Argon2id. Never selected by a read path. Hashing itself is EPIC-005.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("users")
}

// ---------------------------------------------------------------- projects
//
// T053 (EPIC-006) — ownership taken 2026-08-20, the day PMI-DOC-004 v1.0
// discharged the D-10 hold. Until then this was EPIC-001's structural stub;
// the behavioural columns below are exactly the set the stub deliberately
// withheld (FR-001, FR-019).
//
// `engineName` is the per-project engine selection (FR-019): null means
// inherit the deployment default, which is `EngineResolverService`'s existing
// contract — `ProjectEngineSelectionPort` returns null to inherit. A name
// rather than an id, matching `GenerationJob.engineName` and the registry,
// which keys engines by name.

enum ProjectStatus {
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus @default(active)
  // FR-019: null = inherit the registered default engine.
  engineName  String?
  ownerUserId String
  // FR-001: archive is a status, never a delete. Content is preserved intact.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace       Workspace                    @relation(fields: [workspaceId], references: [id])
  generationJobs  GenerationJob[]
  requirements    Requirement[]
  specifications  Specification[]
  decisionRecords ArchitectureDecisionRecord[]
  runs            Run[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("projects")
}

// ---------------------------------------------------------------- requirements
//
// T064 (EPIC-007) — the head of the traceability chain (FR-004 to FR-009).
//
// Indexes on (projectId, type/priority/status): FR-008 is a list operation on
// a register that grows with the project, and SC-009's 1-second p95 applies to
// listing views — filtered reads must be indexed, not scanned.

enum RequirementType {
  business
  functional
  non_functional
  constraint
}

enum RequirementPriority {
  p1
  p2
  p3
}

enum RequirementStatus {
  active
  retired
}

model Requirement {
  id          String              @id @default(uuid())
  workspaceId String
  projectId   String
  // FR-005: human-facing identifier, unique within the project.
  reference   String
  // FR-007: required non-empty — refused with the field named, and a CHECK
  // constraint in the migration backs the service-level refusal.
  description String
  type        RequirementType
  priority    RequirementPriority
  status      RequirementStatus   @default(active)
  // FR-032 seam to EPIC-008: detects material change for out-of-date flagging.
  contentHash String
  // FR-006: soft retire, never delete.
  retiredAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  project   Project              @relation(fields: [projectId], references: [id])
  versions  RequirementVersion[]

  @@unique([projectId, reference])
  @@index([workspaceId])
  @@index([projectId, type])
  @@index([projectId, priority])
  @@index([projectId, status])
  @@map("requirements")
}

// FR-009: append-only edit history. No update or delete path exists in code,
// and the database rejects both via the `requirement_versions_immutable`
// trigger (T458, attached to EPIC-004's shared `reject_mutation()`).
model RequirementVersion {
  id            String              @id @default(uuid())
  workspaceId   String
  requirementId String
  // The text as it stood (data-model.md): prior state, retrievable forever.
  description   String
  type          RequirementType
  priority      RequirementPriority
  authoredById  String
  authoredAt    DateTime            @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  requirement Requirement @relation(fields: [requirementId], references: [id])

  @@index([workspaceId])
  @@index([requirementId, authoredAt(sort: Desc)])
  @@map("requirement_versions")
}

// ---------------------------------------------------------------- specifications
//
// T077 (EPIC-008) — the generated artifact and its immutable version history
// (FR-010, FR-012, FR-013, FR-022, FR-032).
//
// Both raw and parsed engine output are stored (R-007). An AI agent's output is
// prose against a template, not a guaranteed schema: storing only the parsed
// form makes any future parser bug permanent data loss, because re-deriving it
// would mean paying for the engine run again.
//
// `engineName` + `engineVersion` rather than the design DDL's `engine_id` FK —
// the same T012a convention EPIC-007 recorded: schema.prisma is authoritative
// at implementation, the design DDL is design-level. A name matches
// `GenerationJob.engineName`, `Project.engineName`, and the registry, which
// keys engines by name. Neither column is nullable, which is what makes FR-022
// checkable rather than assumed (T082).
//
// The lifecycle STATE lives here because a specification always has one; the
// transition rules and the `LifecycleTransition` record are EPIC-009 (T099,
// T109). Storing a state is not the same as owning the machine that moves it.

enum SpecLifecycleState {
  draft
  review
  approved
  baselined
  implemented
  archived
}

model Specification {
  id               String             @id @default(uuid())
  workspaceId      String
  // FR-010: exactly one project. Singular by construction — a list here would
  // make the requirement unenforceable at the schema.
  projectId        String
  title            String
  lifecycleState   SpecLifecycleState @default(draft)
  currentVersionId String?            @unique
  // FR-022: engine identity, never null. Version identifies BOTH tool and
  // model (R-001) — same engine, different model is a different version.
  engineName       String
  engineVersion    String
  generatedAt      DateTime
  // FR-032: set when a source requirement changes; NEVER auto-corrected, and
  // never a trigger to regenerate. A human decides.
  isOutOfDate      Boolean            @default(false)
  // EPIC-020 T264 (FR-ENH-006/007) — ONE field, wider trigger: generalises
  // FR-032's flag to ANY upstream artifact. Reconciliation clears it with
  // attribution; a baselined specification reconciles by forking (FR-011a).
  currencyStatus   CurrencyStatus     @default(current)
  staleReason      String?
  reconciledAt     DateTime?
  reconciledById   String?
  createdAt        DateTime           @default(now())
  createdById      String
  updatedAt        DateTime           @updatedAt
  updatedById      String

  workspace            Workspace              @relation(fields: [workspaceId], references: [id])
  project              Project                @relation(fields: [projectId], references: [id])
  versions             SpecificationVersion[] @relation("SpecificationVersions")
  currentVersion       SpecificationVersion?  @relation("SpecificationCurrentVersion", fields: [currentVersionId], references: [id])
  lifecycleTransitions LifecycleTransition[]
  validationFindings   ValidationFinding[]
  adrLinks             AdrSpecificationLink[]
  tasks                Task[]

  @@index([workspaceId])
  // SC-009's 1-second p95 applies to listing views, and the list is filtered by
  // lifecycle state — so the filtered read is indexed, not scanned.
  @@index([projectId, lifecycleState])
  @@map("specifications")
}

// FR-013 / SC-007: immutable snapshots, append-only. No update or delete path
// exists in code; the database rejects both via the
// `specification_versions_immutable` trigger — EPIC-009 T460, attached to
// EPIC-004's shared `reject_mutation()`.
model SpecificationVersion {
  id                       String             @id @default(uuid())
  workspaceId              String
  specificationId          String
  versionNumber            Int
  // R-007: the engine's output VERBATIM, always kept.
  contentRaw               String
  contentParsed            Json
  lifecycleStateAtCreation SpecLifecycleState
  // FR-014: who, and when.
  authoredById             String
  authoredAt               DateTime           @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  specification      Specification       @relation("SpecificationVersions", fields: [specificationId], references: [id])
  currentOf          Specification?      @relation("SpecificationCurrentVersion")
  validationFindings ValidationFinding[]

  @@unique([specificationId, versionNumber])
  @@index([workspaceId])
  @@index([specificationId, versionNumber(sort: Desc)])
  @@map("specification_versions")
}

// ---------------------------------------------------------------- lifecycle
//
// T109 (EPIC-009) — who transitioned a specification, and when (FR-014).
// Storing only the current state cannot satisfy FR-014; each move is its own
// append-only row. The permitted set is enforced twice: `assertTransition` in
// code (T099/T106) and the `lifecycle_permitted_transition` CHECK in the
// migration — plus the `lifecycle_transitions_immutable` trigger, because
// lifecycle history that can be edited is not history.

model LifecycleTransition {
  id              String             @id @default(uuid())
  workspaceId     String
  specificationId String
  fromState       SpecLifecycleState
  toState         SpecLifecycleState
  actorId         String
  occurredAt      DateTime           @default(now())
  // C2C (T1104) -- the causal and version identity that lets this row close the
  // proposal -> verdict -> transition chain. Nullable: history predates them.
  correlationId      String?
  causationId        String?
  idempotencyKey     String?
  actorSnapshotId    String?
  previousVersionId  String?
  resultingVersionId String?

  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  specification Specification @relation(fields: [specificationId], references: [id])

  @@index([workspaceId])
  @@index([specificationId, occurredAt(sort: Desc)])
  @@index([workspaceId, correlationId])
  @@map("lifecycle_transitions")
}

// ---------------------------------------------------------------- findings
//
// T120 (EPIC-009) — validation findings, bound to the VERSION validated
// (FR-023). A finding without a location is malformed engine output and is
// refused before storage (T121); the migration's CHECK backs that refusal.

enum FindingSeverity {
  info
  warning
  error
}

model ValidationFinding {
  id                     String          @id @default(uuid())
  workspaceId            String
  specificationId        String
  specificationVersionId String
  // FR-023: must identify the part of the specification concerned.
  location               String
  severity               FindingSeverity
  message                String
  createdAt              DateTime        @default(now())

  workspace            Workspace            @relation(fields: [workspaceId], references: [id])
  specification        Specification        @relation(fields: [specificationId], references: [id])
  specificationVersion SpecificationVersion @relation(fields: [specificationVersionId], references: [id])

  @@index([workspaceId])
  @@index([specificationVersionId])
  @@map("validation_findings")
}

// ---------------------------------------------------------------- tasks
//
// T100 (EPIC-012) — tasks generated from an APPROVED specification (FR-020).
// Three states only; richer workflow states arrive with the Phase 2 workflow
// engine (spec Assumptions). Engine identity is stamped per row (FR-022).

enum TaskStatus {
  not_started
  in_progress
  done
}

model Task {
  id              String     @id @default(uuid())
  workspaceId     String
  specificationId String
  description     String
  status          TaskStatus @default(not_started)
  engineName      String
  engineVersion   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  specification Specification @relation(fields: [specificationId], references: [id])

  @@index([workspaceId])
  @@index([specificationId, status])
  @@map("tasks")
}

// ---------------------------------------------------------------- traceability
//
// T078 (EPIC-011) — the graph that makes the artifacts a system (FR-029 to
// FR-031). POLYMORPHIC on purpose: source/target are (type, id) pairs with no
// FK, because the two Phase 1 edges span three tables and Phase 2 adds more.
// The permitted-edge rule lives in code (link-writer) and in the migration's
// CHECK — same two-layer pattern as the lifecycle.
//
// Indexed BOTH ways: both traversal directions are first-class (FR-030) and
// must stay fast at 500 specifications per project (SC-009).

// EPIC-022 T301 — widened to the twelve chain stages (FR-ENH-021, R-017-7).
enum TraceArtifactType {
  vision
  goal
  capability
  requirement
  specification
  architecture
  plan
  task
  code
  test
  release
  operation
}

// Widened, not replaced: the two Phase 1 types stay; the twelve chain link
// types of the source document join them.
enum TraceRelationship {
  generated_from
  derived_from
  vision
  goals
  capabilities
  requirements
  specifications
  architecture
  planning
  tasks
  code
  tests
  release
  operations
}

model TraceabilityLink {
  id           String            @id @default(uuid())
  workspaceId  String
  sourceType   TraceArtifactType
  sourceId     String
  targetType   TraceArtifactType
  targetId     String
  relationship TraceRelationship
  createdAt    DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([sourceType, sourceId, targetType, targetId, relationship])
  @@index([workspaceId])
  @@index([targetType, targetId])
  @@index([sourceType, sourceId])
  @@map("traceability_links")
}

// ---------------------------------------------------------------- decisions
//
// T143 (EPIC-016) — Architecture Decision Records (FR-034). Status is a
// three-value enum with no transition guards — deliberately unlike the
// specification lifecycle. Superseding is a status, not a deletion.
//
// The many-to-many to specifications (`adr_specification_links`) waited for
// EPIC-008's `Specification` model and landed with the integration — the
// sequencing this comment used to record is complete.

enum AdrStatus {
  proposed
  accepted
  superseded
}

model ArchitectureDecisionRecord {
  id           String    @id @default(uuid())
  workspaceId  String
  projectId    String
  // Unique per project, not globally: two projects may each hold ADR-0001.
  reference    String
  title        String
  status       AdrStatus @default(proposed)
  context      String
  decision     String
  consequences String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace          Workspace              @relation(fields: [workspaceId], references: [id])
  project            Project                @relation(fields: [projectId], references: [id])
  specificationLinks AdrSpecificationLink[]

  @@unique([projectId, reference])
  @@index([workspaceId])
  @@index([projectId, status])
  @@map("architecture_decision_records")
}

// FR-034: decisions link to the specifications they affect. An explicit join
// model rather than an implicit m2m so the composite key matches the design
// DDL exactly and the link rows stay visible to the store ports.
model AdrSpecificationLink {
  adrId           String
  specificationId String

  adr           ArchitectureDecisionRecord @relation(fields: [adrId], references: [id])
  specification Specification              @relation(fields: [specificationId], references: [id])

  @@id([adrId, specificationId])
  @@map("adr_specification_links")
}

// ---------------------------------------------------------------- jobs

enum JobKind {
  generate_specification
  generate_tasks
  validate_specification
}

enum JobState {
  queued
  running
  succeeded
  failed
  cancelled
  timed_out
}

// FR-026 / SC-005: there is deliberately no `unknown` member.
enum JobFailureReason {
  engine_unavailable
  engine_error
  malformed_output
  empty_output
  timeout
  cancelled
  input_too_large
  empty_selection
}

model GenerationJob {
  id            String            @id @default(uuid())
  workspaceId   String
  projectId     String
  // Idempotency: a duplicate submission joins the existing job rather than
  // starting — and billing — a second engine run.
  jobKey        String
  kind          JobKind
  requestedById String
  engineName    String
  engineVersion String
  // Correlation identifier, carried API -> queue -> worker -> sandbox (PC-3).
  correlationId String
  inputRefs     Json
  state         JobState          @default(queued)
  failureReason JobFailureReason?
  // T845 (EPIC-008) — the artifact a succeeded job produced. Null until there
  // is one, and null forever on a job that failed, was cancelled, or timed out:
  // there is nothing to point at (FR-027, SC-006). Written in the same
  // transaction as the specification itself.
  resultRef     String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])

  // Only one LIVE job per idempotency key. Enforced in the migration as a
  // partial unique index over state IN ('queued','running').
  @@index([projectId, jobKey])
  @@index([projectId, createdAt])
  @@index([workspaceId])
  @@map("generation_jobs")
}

// ---------------------------------------------------------------- audit

enum AuditAction {
  create
  update
  lifecycle_transition
  engine_invocation
  access_refused
}

enum AuditOutcome {
  success
  refused
  failed
}

// FR-033 / SC-012. Append-only: no update or delete path exists in code, and
// a database trigger rejects UPDATE and DELETE (see specs/_shared/schema.sql).
model AuditEntry {
  id          String       @id @default(uuid())
  workspaceId String
  // Null ONLY for unauthenticated refusals — the events most worth recording.
  actorId     String?
  action      AuditAction
  targetType  String
  targetId    String?
  outcome     AuditOutcome
  detail      Json?
  occurredAt  DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_entries")
}

// ---------------------------------------------------------------- engines
//
// T034 — the engine set a deployment accepted at startup.
//
// NOT tenant-scoped, so no workspaceId: an engine is a property of the
// deployment, not of a customer. FR-002's universal-column rule applies to
// tenant-scoped models; recording the exception here rather than leaving a
// reader to wonder whether it was forgotten.
//
// This table is a RECORD, not the source of truth. Adapters are supplied at the
// composition root (worker/src/engine-composition.ts) and validated there
// (FR-021); rows here exist so an operator can see which engines a running
// deployment accepted, and at what version, without reading the code.
//
// Per-project engine SELECTION is deliberately absent. The Project stub must
// not grow before EPIC-006 owns it, and EPIC-006 owns selection — so
// EngineResolverService reads it through a port that EPIC-006 will implement.

model EngineRegistration {
  id           String   @id @default(uuid())
  name         String   @unique
  // Identifies BOTH tool and model (FR-022, E10). Same Spec Kit + different
  // model is a different version, because the output differs.
  version      String
  capabilities String[]
  isDefault    Boolean  @default(false)
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("engine_registrations")
}

// ---------------------------------------------------------------- steering
//
// EPIC-019 — steering scopes, documents, and provenance (FR-ENH-001..005).

enum SteeringScopeType {
  organization
  workspace
  project
  product
}

// FR-ENH-002 — the ten named subjects. Anything else is refused by name in
// steering.validation.ts; the enum makes the database agree.
enum SteeringSubject {
  organization
  workspace
  product
  architecture
  coding_standards
  security
  ui_standards
  business_rules
  technology_stack
  ai_governance
}

enum SteeringDocumentStatus {
  active
  retired
}

// EPIC-020 T264 — living-specification currency (FR-ENH-006).
enum CurrencyStatus {
  current
  stale
}

// T229 — a resolved position in the four-level hierarchy.
model SteeringScope {
  id          String            @id @default(uuid())
  workspaceId String
  scopeType   SteeringScopeType
  scopeRef    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id])
  documents SteeringDocument[]

  @@unique([scopeType, scopeRef])
  @@index([workspaceId])
  @@map("steering_scopes")
}

// T232 — versioned steering content. Retire marks, never deletes; the edit
// history is append-only, modelled the way RequirementVersion is.
model SteeringDocument {
  id          String                 @id @default(uuid())
  workspaceId String
  subject     SteeringSubject
  scopeId     String
  content     String
  version     Int
  status      SteeringDocumentStatus @default(active)
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  scope     SteeringScope @relation(fields: [scopeId], references: [id])

  @@unique([subject, scopeId, version])
  @@index([workspaceId])
  @@index([scopeId, status])
  @@map("steering_documents")
}

// EPIC-022 T297 (R-017-6) — the twenty-one-section structure as VERSIONED
// DATA, not a stored skeleton: conformance is a validation rule producing
// FR-023 findings. Deployment-scoped (product configuration, D-16: product
// outputs only — never this repository's own documents).
model StructureDefinition {
  id        String   @id @default(uuid())
  version   Int
  // Ordered [{name, required}] — order is part of the definition.
  sections  Json
  appliesTo String   @default("product_outputs")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appliesTo, version])
  @@map("structure_definitions")
}

// ---------------------------------------------------------------- reviews
//
// EPIC-021 — review gates and roles (FR-ENH-012..016, 023/024).

// T274 — the twelve roles. Deployment-scoped like engine_registrations:
// the roster is platform configuration, not tenant data.
model ReviewRole {
  id                     String   @id @default(uuid())
  name                   String   @unique
  responsibility         String
  permittedArtifactTypes String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("review_roles")
}

// T278 — a gate on a lifecycle transition, naming the roles that must run.
// requiredRoles never empty: the gate fails closed (clarification 2026-08-19).
model ReviewGate {
  id            String   @id @default(uuid())
  workspaceId   String
  transition    String
  requiredRoles String[]
  blocking      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  outcomes  GateOutcome[]

  @@index([workspaceId, transition])
  @@map("review_gates")
}

// T287 — append-only, the audit_entries treatment, with ONE exception the
// trigger carves out: the one-time decision fill on an undecided row.
model GateOutcome {
  id                 String    @id @default(uuid())
  workspaceId        String
  specificationId    String
  gateId             String
  rolesRun           Json
  gateFailed         Boolean
  humanDecision      String?
  decidedById        String?
  decidedAt          DateTime?
  overriddenFindings Json?
  occurredAt         DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  gate      ReviewGate      @relation(fields: [gateId], references: [id])
  findings  ReviewFinding[]

  @@index([workspaceId])
  @@index([specificationId])
  @@map("gate_outcomes")
}

// T282 — attributed or refused: roleId and location are REQUIRED (SC-ENH-005).
model ReviewFinding {
  id            String   @id @default(uuid())
  workspaceId   String
  gateOutcomeId String
  roleId        String
  location      String
  severity      String
  message       String
  createdAt     DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  outcome   GateOutcome @relation(fields: [gateOutcomeId], references: [id])

  @@index([workspaceId])
  @@index([gateOutcomeId])
  @@map("review_findings")
}

// ------------------------------------------------------------ dependencies
//
// EPIC-020 T252 (R-017-3) — a SEPARATE table from traceability_links:
// derivation links are system-written, acyclic, immutable; dependency edges
// are user-maintained, cycle-checked, mutable. One table with a
// discriminator would make every query filter by kind.

model DependencyEdge {
  id             String   @id @default(uuid())
  workspaceId    String
  sourceType     String
  sourceId       String
  targetType     String
  targetId       String
  dependencyType String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([sourceType, sourceId, targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([workspaceId])
  @@map("dependency_edges")
}

// ---------------------------------------------------------------- runs
//
// EPIC-023 T343 — an unattended run and what it deferred (FR-RUN-001..008).
//
// A Run is NOT a GenerationJob (R-002-1): a job is one engine invocation; a
// run spans many across a user-selected range, survives questions, and
// carries an access snapshot. `reached_stop_point` is a SUCCESS state
// (FR-RUN-008a) — merging the two would make it a meaningless job outcome.

enum RunMode {
  interactive
  unattended
}

enum RunStopRange {
  after_specification
  through_tasks
}

enum RunState {
  running
  reached_stop_point
  failed
  cancelled
}

model Run {
  id             String       @id @default(uuid())
  workspaceId    String
  projectId      String
  mode           RunMode
  stopRange      RunStopRange
  state          RunState     @default(running)
  // FR-ACC-028 / R-002-4 — resolved grants at start, read from, never
  // re-queried. Written by EPIC-024; null until that epic lands.
  accessSnapshot Json?
  initiatedById  String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  // Why it stopped, when not a clean stop point (FR-RUN-008). On a clean stop
  // it reports that the run stopped at the selected range (FR-RUN-008a).
  outcomeReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  project       Project            @relation(fields: [projectId], references: [id])
  questions     RecordedQuestion[]
  reviewSession ReviewSession?

  @@index([workspaceId])
  @@index([projectId, state])
  @@map("runs")
}

// T343 — a question the run would have asked, recorded instead (FR-RUN-003,
// FR-RUN-004, FR-RUN-007). Context is REQUIRED: enough for someone who did
// not start the run to understand what is being asked.
model RecordedQuestion {
  id                       String   @id @default(uuid())
  workspaceId              String
  runId                    String
  context                  String
  optionsConsidered        Json
  suggestedAnswer          String
  // What the run actually proceeded on — a provisional answer, not a decision.
  provisionalAnswerApplied String?
  // True when the asker's grants hide the artifact it concerns: shown as
  // restricted rather than silently omitted (parent edge case).
  restricted               Boolean  @default(false)
  createdAt                DateTime @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  run       Run                  @relation(fields: [runId], references: [id])
  markings  ProvisionalMarking[]
  answers   Answer[]

  @@index([workspaceId])
  @@index([runId])
  @@map("recorded_questions")
}

// T343 — a LINK, not a flag (R-002-5): it joins an artifact to the SPECIFIC
// question governing it, which is what lets markings clear selectively when
// one question is answered. A boolean clears everything or nothing.
model ProvisionalMarking {
  id           String    @id @default(uuid())
  workspaceId  String
  artifactType String
  artifactId   String
  questionId   String
  clearedAt    DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  question  RecordedQuestion @relation(fields: [questionId], references: [id])

  @@index([workspaceId])
  @@index([artifactType, artifactId])
  @@index([questionId])
  @@map("provisional_markings")
}

// T350 — append-only (the audit_entries treatment): approval of a provisional
// specification is refused without one (FR-RUN-005a), and SC-005a requires
// zero un-overridden provisional approvals.
model ProvisionalApprovalOverride {
  id            String   @id @default(uuid())
  workspaceId   String
  approvalRef   String
  approverId    String
  approvedAt    DateTime @default(now())
  // The SPECIFIC provisional items accepted (FR-RUN-005b).
  itemsAccepted Json

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([approvalRef])
  @@map("provisional_approval_overrides")
}

// ---------------------------------------------------------------- review
//
// EPIC-023 T357 — one session per run, unique by construction; a run raising
// zero questions creates NO session. `open → submitted` is one way; a
// submitted session is closed to edits and retained permanently (FR-RUN-015,
// FR-RUN-018, FR-RUN-020) — the DELETE trigger in the migration backs that.

enum ReviewSessionState {
  open
  submitted
}

enum AnswerState {
  draft
  committed
}

/// T1107 -- the authoritative, append-only gate decision (EPIC-021).
/// `GateOutcome` remains the mutable two-phase working record; this is the
/// immutable answer EPIC-030 consumes. A correction links via `supersedesId`.
model GateFinalOutcome {
  id                  String    @id @default(uuid())
  workspaceId         String
  specificationId     String
  fromStatus          String
  toStatus            String
  targetVersionId     String?
  gateSetVersion      String
  gateId              String
  disposition         String
  reason              String
  evaluatorId         String
  evaluatorSnapshotId String?
  decidedById         String?
  decidedBySnapshotId String?
  decidedAt           DateTime?
  evidenceRefs        String[]  @default([])
  correlationId       String
  causationId         String
  supersedesId        String?
  createdAt           DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, specificationId, fromStatus, toStatus])
  @@index([workspaceId, gateId])
  @@map("gate_final_outcomes")
}

/// T1117 -- explicit auto-application policy (EPIC-030). Append-only and
/// versioned: a change appends a new version rather than rewriting the row an
/// earlier adjudication was decided under.
model ApplicationPolicy {
  id                   String   @id @default(uuid())
  workspaceId          String
  targetArtifactType   String
  fromStatus           String
  toStatus             String
  requiredAuthorities  String[] @default([])
  autoApplyPermitted   Boolean
  policyVersion        Int
  state                String
  createdById          String
  createdBySnapshotId  String?
  approvedById         String?
  approvedBySnapshotId String?
  effectiveFrom        DateTime @default(now())
  correlationId        String
  supersedesId         String?
  createdAt            DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, targetArtifactType, fromStatus, toStatus])
  @@map("application_policies")
}

model ReviewSession {
  id          String             @id @default(uuid())
  workspaceId String
  runId       String             @unique
  state       ReviewSessionState @default(open)
  openedAt    DateTime           @default(now())
  submittedAt DateTime?
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  run       Run       @relation(fields: [runId], references: [id])

  @@index([workspaceId])
  @@map("review_sessions")
}

// T357 + T802 — a draft or committed answer with permanent attribution
// (FR-RUN-010..013, SC-006). Conflicting answers BOTH survive (R-002-6);
// resolution (FR-RUN-013a) selects a winner and deletes nothing — the record
// has to show that the disagreement happened (SC-015).
model Answer {
  id                   String      @id @default(uuid())
  workspaceId          String
  questionId           String
  value                String
  authorId             String
  recordedAt           DateTime    @default(now())
  note                 String?
  state                AnswerState @default(draft)
  conflict             Boolean     @default(false)
  // T802 — conflict resolution, restricted to owner or initiator.
  selectedAsWinner     Boolean     @default(false)
  conflictResolvedById String?
  conflictResolvedAt   DateTime?
  updatedAt            DateTime    @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  question  RecordedQuestion @relation(fields: [questionId], references: [id])

  @@index([workspaceId])
  @@index([questionId])
  @@map("answers")
}

// ---------------------------------------------------------------- access
//
// EPIC-024 T376 — per-artifact access grants (FR-ACC-021..028).
//
// Layer 2 of the two-layer rule: workspace scoping (EPIC-004, layer 1) is
// never modified; a grant refusal is indistinguishable from absence
// (FR-ACC-024). Revocation is a TIMESTAMP, not a delete — the audit trail
// survives. The last-editor invariant (FR-ACC-027) is enforced inside the
// revoke transaction, not by a pre-check.

enum AccessLevel {
  read
  edit
}

model AccessGrant {
  id           String      @id @default(uuid())
  workspaceId  String
  artifactType String
  artifactId   String
  userId       String
  level        AccessLevel
  grantedById  String
  grantedAt    DateTime    @default(now())
  revokedAt    DateTime?
  revokedById  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([artifactType, artifactId])
  @@index([userId])
  @@map("access_grants")
}

// T376 — every refusal is recorded, in the SAME transaction as the refusal
// (FR-ACC-023, SC-007, SC-013). Append-only: the trigger rejects mutation.
model AccessAttemptRecord {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  artifactType String
  artifactId   String
  action       String
  reason       String
  attemptedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([artifactType, artifactId])
  @@map("access_attempt_records")
}

// ---------------------------------------------------------------- storage
//
// EPIC-025 T388 — external storage connections and publish records
// (FR-PUB-029..040).
//
// The refresh token is ENCRYPTED AT REST and never selected by a read path;
// it is discarded (nulled) on disconnection (FR-PUB-029b). Disconnection must
// not touch any platform artifact — it is a timestamp plus a token discard.

enum ConnectionStatus {
  healthy
  needs_reauthorisation
  unavailable
}

enum PublishState {
  running
  succeeded
  partial
  failed
}

// FR-PUB-035 / SC-009: deliberately NO `unknown` member, matching
// job_failure_reason — a generic failure is a defect.
enum PublishFailureReason {
  provider_unavailable
  authorisation_expired
  quota_exceeded
  size_limit_exceeded
  destination_missing
}

model StorageConnection {
  id                    String           @id @default(uuid())
  workspaceId           String
  providerName          String
  // Folder or bucket within the provider (FR-PUB-029).
  destination           String
  status                ConnectionStatus @default(healthy)
  authorisedById        String
  // Encrypted at rest; never returned by any endpoint; nulled on disconnect.
  refreshTokenEncrypted String?
  lastCheckedAt         DateTime?
  disconnectedAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  publishRecords PublishRecord[]

  @@index([workspaceId])
  @@map("storage_connections")
}

// T388 — what was published, when, by whom, and where it landed
// (FR-PUB-034). The record SURVIVES a failed publish, stating what did and
// did not land — and survives provider switches (FR-PUB-038, SC-010).
model PublishRecord {
  id                   String                @id @default(uuid())
  workspaceId          String
  projectId            String
  connectionId         String
  initiatedById        String
  artifactsIncluded    Json
  // Each exclusion carries its reason (FR-PUB-033).
  artifactsExcluded    Json
  state                PublishState
  failureReason        PublishFailureReason?
  destinationLocations Json
  publishedAt          DateTime              @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id])
  connection StorageConnection @relation(fields: [connectionId], references: [id])

  @@index([workspaceId])
  @@index([projectId, publishedAt(sort: Desc)])
  @@map("publish_records")
}

// T388 — where each artifact landed. Retained through a provider switch;
// deleting the file at the provider has ZERO effect on the platform artifact
// (FR-PUB-037, SC-012) — the reference merely goes stale. On disconnection it
// is retained and marked no longer tracked (FR-PUB-038).
model PublishedFileReference {
  id                  String   @id @default(uuid())
  workspaceId         String
  artifactType        String
  artifactId          String
  connectionId        String
  destinationLocation String
  publishedVersion    String
  stale               Boolean  @default(false)
  noLongerTracked     Boolean  @default(false)
  publishedAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([artifactType, artifactId])
  @@index([connectionId])
  @@map("published_file_references")
}

// T242 — the provenance record, written AT GENERATION TIME, never recomputed.
// An artifact generated with no steering in scope has one with an empty set —
// not a missing row (SC-ENH-001).
model SteeringApplication {
  id               String   @id @default(uuid())
  workspaceId      String
  artifactId       String
  artifactType     String
  // The exact document versions that constrained this generation.
  appliedDocuments Json
  // FR-ENH-005 — {winning, overridden} pairs; the broader rule is recorded,
  // not discarded.
  overrides        Json
  appliedAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([artifactType, artifactId])
  @@index([workspaceId])
  @@map("steering_applications")
}

// ═══════════════════════════════════════════════════════════════════════════
// EPIC-030 — the Governed Engineering Loop. T926.
//
// Three models and no fourth. GateOutcome is embedded as JSON on the
// transition (data-model §5), not a table: the loop stores gate OUTCOMES, and
// the gates themselves are EPIC-021's — which already owns a `GateOutcome`
// model here for a different purpose.
//
// subjectType and subjectId stay opaque throughout. FR-GEL-061 forbids Room
// vocabulary in the loop, and a foreign key to a requirements table would be
// exactly that. The Room owns the join.
// ═══════════════════════════════════════════════════════════════════════════

enum LoopTransitionOutcome {
  accepted
  refused
  conflict
  exception
  violation
}

enum LoopActorKind {
  human
  automation
}

// The versioned binding of one workflow type to the model. FR-GEL-005.
//
// NEVER UPDATED. A change writes a new configVersion and sets supersededBy on
// the prior row, which is what makes FR-GEL-006 hold by construction: an
// in-flight object's pinned configVersion still resolves to the bytes it
// started under. An UPDATE here would rewrite history for every object mid-loop.
model LoopInstanceConfiguration {
  id            String   @id @default(uuid())
  workspaceId   String
  workflowType  String
  configVersion Int
  // Derived from the programme file, not writable by a tenant (FR-GEL-009).
  stages        Json
  // Per transition. The tenant-configured half.
  authorities   Json
  requiredGates Json
  triggerRules  Json
  // FR-GEL-016 / R-030-7 — both present or the configuration does not load.
  // The reviewed commit now; the EPIC-031 decision id once that lands.
  approvedBy    String
  approvalRef   String
  approvedAt    DateTime @default(now())
  // The configVersion that replaced this one; null while current.
  supersededBy  Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, workflowType, configVersion])
  @@index([workspaceId, workflowType])
  @@map("loop_instance_configurations")
}

// The governed object under a loop. This Epic owns its POSITION, not what it is.
model LoopObject {
  id            String    @id @default(uuid())
  workspaceId   String
  projectId     String
  workflowType  String
  // FR-GEL-006 — fixed at creation, never rewritten.
  configVersion Int
  // Opaque to this Epic (FR-GEL-061).
  subjectType   String
  subjectId     String
  // Derived from the transitions; there is no other writer.
  currentStage  String
  // R-030-1 — the OCC token. Every accepted transition increments it.
  version       Int       @default(0)
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  transitions LoopTransition[]

  // SC-GEL-006 — which stage is it in and how long has it been there, without a scan.
  @@index([workspaceId, workflowType, currentStage])
  @@index([workspaceId, subjectType, subjectId])
  @@map("loop_objects")
}

// Every state change. APPEND-ONLY: no UPDATE, no DELETE, enforced by trigger in
// the migration the way EPIC-004 enforces audit immutability.
model LoopTransition {
  id             String                @id @default(uuid())
  workspaceId    String
  objectId       String
  // FR-GEL-012 — the OCC token the attempt was made against, kept even when the
  // attempt lost, because a conflict is a fact worth reading later.
  objectVersion  Int
  // Null only for the initial Event.
  fromStage      String?
  toStage        String
  outcome        LoopTransitionOutcome
  // FR-GEL-014 — required when outcome != accepted, by CHECK constraint.
  refusalReason  String?
  // FR-GEL-015 — on conflict, the transition that won.
  wonBy          String?
  actorId        String
  // FR-GEL-032 — distinguishable without inference.
  actorKind      LoopActorKind
  authorityBasis String
  // FR-GEL-031 — required when actorKind = automation, by CHECK constraint.
  // RULE-11 turns on this one, which is why it is not a service check.
  triggerRuleId  String?
  triggerEventId String?
  configVersion  Int
  // data-model §5 — embedded, one entry per required gate.
  gateOutcomes   Json
  occurredAt     DateTime              @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  object    LoopObject @relation(fields: [objectId], references: [id])

  @@index([objectId, occurredAt])
  @@index([workspaceId, outcome])
  @@map("loop_transitions")
}

// ═══════════════════════════════════════════════════════════════════════════
// EPIC-033 — the Requirement Room. T337u.
//
// Six tables. What is NOT here matters as much: no requirement TEXT and no
// second requirement register. FR-RQR-002 and D-33 — EPIC-007 owns the
// register, and this Room consumes it. A Baseline freezes EPIC-007 requirement
// VERSION IDS, never copies of what they say (R-033-5), because a copy is a
// second source of truth that drifts silently and looks right the whole time.
//
// AiAnalysis is embedded on the candidate rather than a table of its own
// (data-model §3): it is epistemically typed output ABOUT a candidate, not an
// entity with a lifecycle.
// ═══════════════════════════════════════════════════════════════════════════

enum RoomEpistemic {
  fact
  inference
  recommendation
  open_question
}

enum DecidedByKind {
  human
  agent
}

// Raw intent, normalized, before anything is decided. FR-RQR-010.
model RequirementCandidate {
  id            String        @id @default(uuid())
  workspaceId   String
  projectId     String
  // The EPIC-030 loop object this Room instance governs.
  roomObjectId  String
  // Which intake it came from — document, direct input, imported artifact.
  sourceRef     String
  normalizedText String
  // FR-RQR-011, R-033-4 — REQUIRED. An unlabelled element must not be
  // presentable, and the cheapest guarantee is that it cannot be stored.
  epistemic     RoomEpistemic
  // AI output about this candidate, epistemically typed (data-model §3).
  aiAnalysis    Json?
  // The EPIC-007 requirement id once decided; null while a candidate.
  // A REFERENCE, never a copy — EPIC-007 owns the text.
  promotedTo    String?
  // FR-RQR-030, T339b — the criteria the baseline gate reads.
  //
  // Held HERE rather than passed in with an approval, so the gate reads data
  // this Room owns. A caller that supplied its own answer to "does this have
  // criteria" could assert its way past SC-RQR-003's "zero", which is the one
  // number that requirement is.
  //
  // Null and [] are the same state — no criteria — and both block. The column
  // is nullable only because the rows that predate it are.
  acceptanceCriteria Json?
  // DEFAULT TRUE, and that is the whole point: a candidate is presumed to need
  // criteria until somebody says otherwise. Defaulting false would make the
  // gate fire only for candidates a caller had already flagged, which is a
  // default that permits — the failure `requirement-room.tokens.ts` names.
  intendedForImplementation Boolean @default(true)
  createdAt     DateTime      @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  clarifications Clarification[]

  @@index([workspaceId, roomObjectId])
  @@index([workspaceId, projectId])
  @@map("requirement_candidates")
}

// FR-RQR-012 — asked as one set, answerable in place, and RETAINED once
// answered (FR-RQR-013): the answer is part of the requirement record, not
// scaffolding to discard.
model Clarification {
  id          String    @id @default(uuid())
  // FR-002 / BR-0001 — every tenant-scoped model carries workspaceId from the
  // FIRST migration, so row-level security is a switch rather than a data
  // migration. Reachable via the candidate is not the same as scoped.
  workspaceId String
  roomObjectId String
  candidateId String?
  question    String
  // Actor id, or an AgentExecutionRecord id when AI-generated.
  askedBy     String
  answer      String?
  answeredBy  String?
  answeredAt  DateTime?
  // Derived: an open question on a candidate intended for implementation.
  blocksBaseline Boolean @default(false)
  createdAt   DateTime  @default(now())

  candidate RequirementCandidate? @relation(fields: [candidateId], references: [id])

  @@index([workspaceId])
  @@index([roomObjectId])
  @@index([roomObjectId, blocksBaseline])
  @@map("clarifications")
}

// FR-RQR-040, FR-RQR-041 — a human decision, with its rationale.
model RequirementDecision {
  id             String        @id @default(uuid())
  workspaceId    String
  roomObjectId   String
  decidedBy      String
  // FR-RQR-041 — enforced by CHECK constraint as well as by EPIC-031's policy.
  // The belt beside the braces: a caller can go around a service.
  decidedByKind  DecidedByKind
  // The BR-0005 record, CONSUMED from EPIC-031 and not redefined here.
  authorityBasis String
  objectVersion  Int
  chosenOption   String
  // FR-RQR-023 — the options NOT taken are retained. A decision with only the
  // chosen option recorded cannot answer "what else was considered".
  declinedOptions Json
  // BR-0025 — REQUIRED. A decision with no rationale is a decision nobody can
  // review, and it looks identical to one that was reasoned.
  rationale      String
  // → EPIC-031's Decision, which evaluated the authority.
  decisionId     String?
  decidedAt      DateTime      @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  baselines Baseline[]

  @@index([workspaceId, roomObjectId])
  @@map("requirement_decisions")
}

// BR-0026 — the entity this Epic exists to add.
//
// APPEND-ONLY. A baseline is superseded, never rewritten: RULE-02 says
// baselines do not mutate silently, and rewriting one would change what an
// approved decision approved.
model Baseline {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String
  // Monotonic per project; never reused.
  version     Int
  // R-033-5 — the EPIC-007 requirement VERSION IDS frozen. Never their text.
  memberVersionIds Json
  // Content hash over the member set, via requirement-hash.ts. FR-RQR-051's
  // in-place-edit refusal asserts this is unchanged.
  setHash     String
  approvedBy  String
  approvedAt  DateTime @default(now())
  rationale   String
  decisionId  String
  // The baseline that replaced this one; null while current.
  supersededBy Int?
  // → EPIC-032, satisfied before approval completes (FR-RQR-053).
  evidenceContractRef String?

  workspace  Workspace           @relation(fields: [workspaceId], references: [id])
  decision   RequirementDecision @relation(fields: [decisionId], references: [id])
  exceptions BaselineException[]
  handoffs   Handoff[]

  @@unique([projectId, version])
  @@index([workspaceId, projectId])
  @@map("baselines")
}

// FR-RQR-032 — a member baselined without acceptance criteria needs an
// explicit, authorized exception. Both fields required: an exception nobody
// granted, or with no stated reason, is a bypass with a nicer name.
model BaselineException {
  id                   String   @id @default(uuid())
  // FR-002 / BR-0001 — see Clarification.
  workspaceId          String
  baselineId           String
  requirementVersionId String
  // Which precondition was waived — currently only missing acceptance criteria.
  condition            String
  authorizedBy         String
  reason               String
  createdAt            DateTime @default(now())

  baseline Baseline @relation(fields: [baselineId], references: [id])

  @@index([workspaceId])
  @@index([baselineId])
  @@map("baseline_exceptions")
}

// FR-RQR-060, FR-RQR-062 — a baselined set selected as specification input.
model Handoff {
  id              String   @id @default(uuid())
  // FR-002 / BR-0001 — see Clarification.
  workspaceId     String
  baselineId      String
  // The VERSION selected, not the baseline generally: a handoff records which
  // frozen set went to specification.
  baselineVersion Int
  // Opaque, ENGINE-AGNOSTIC (FR-RQR-062). A typed reference to one engine's
  // workflow would put an engine's model in this Room.
  specificationWorkflowRef String
  selectedBy      String
  selectedAt      DateTime @default(now())

  baseline Baseline @relation(fields: [baselineId], references: [id])

  @@index([workspaceId])
  @@index([baselineId])
  @@map("handoffs")
}

/// T1093 (EPIC-030 Phase C2A) — immutable adjudication evidence (FR-GEL-072).
///
/// Append-only, enforced by a trigger this Epic's migration ATTACHES. The
/// reject_mutation() function already existed; a function protects nothing
/// until a trigger binds it to a table.
///
/// `(workspaceId, proposalId, idempotencyKey)` is unique: it is what makes a
/// retry return the original verdict instead of adjudicating twice
/// (FR-GEL-071).
model AdjudicationRecord {
  id                  String   @id @default(uuid())
  workspaceId         String
  proposalId          String
  executionId         String
  specificationId     String
  idempotencyKey      String
  expectedStatus      String
  requestedStatus     String
  verdict             String
  reason              String
  proposerId          String
  proposerType        String
  proposerSnapshotId  String
  approverId          String?
  approverSnapshotId  String?
  appliedTransitionId String?
  // X1 -- verdict-specific columns. CHECK constraints in
  // 20260825120000_epic030_adjudication_refusal make each one required by
  // exactly one verdict and forbidden on the other five.
  refusalStage         String?
  refusalReasonCode    String?
  requiredApproverRole String?
  observedStatus       String?
  reconciliationCause  String?
  reconciliationDetail String?
  correlationId       String
  causationId         String
  decidedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, proposalId, idempotencyKey])
  @@index([workspaceId, specificationId])
  @@index([executionId])
  @@map("adjudication_records")
}

/// T1097 -- the durable intent recorded BEFORE EPIC-009 is asked to apply a
/// transition. Append-only: `settle` appends a 'settled' row rather than
/// updating the 'opened' one, so an outcome nobody observed cannot erase the
/// record that the attempt was made.
/// T1131 (C2E) -- evidence of the owner-grant backfill, including the artifacts
/// whose creator could NOT be resolved. Those stay inaccessible on purpose:
/// inventing an owner is the defect this migration exists to close.
/// T1026 (EPIC-037 Band A) -- stable root identity for a governed execution.
/// `governanceState` is PROJECTED from the event stream, never written by a
/// connector.
model Execution {
  id                String   @id @default(uuid())
  correlationId     String
  causationId       String?
  idempotencyKey    String
  workspaceId       String
  projectId         String?
  command           String
  argsSanitized     Json
  initiatorType     String
  initiatorId       String
  surface           String
  environment       String?
  governanceState   String   @default("provisional")
  parentExecutionId String?
  contractVersion   String
  registeredAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  parent    Execution?  @relation("ExecutionRerun", fields: [parentExecutionId], references: [id])
  reruns    Execution[] @relation("ExecutionRerun")

  events          ExecutionEvent[]
  state           ExecutionState?
  agentIdentities AgentIdentitySnapshot[]
  bindings        ExecutionTargetBinding[]
  artifacts       ExecutionArtifact[]
  comments        ExecutionComment[]
  proposals       StatusTransitionProposal[]
  outbox          ExecutionOutbox[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, correlationId])
  @@index([parentExecutionId])
  @@map("executions")
}

/// THE authority. Append-only; `sequence` is server-assigned and gapless per
/// execution -- deliberately not a database sequence, which is global and gaps
/// on rollback.
model ExecutionEvent {
  id             String   @id @default(uuid())
  workspaceId    String
  executionId    String
  sequence       Int
  localSequence  Int?
  class          String
  type           String
  payload        Json
  occurredAt     DateTime
  recordedAt     DateTime @default(now())
  emittedBy      String
  idempotencyKey String
  integrityHash  String
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  execution Execution @relation(fields: [executionId], references: [id])

  @@unique([executionId, sequence])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, executionId])
  @@map("execution_events")
}

/// PROJECTION. Rebuildable, therefore mutable -- attaching immutability here
/// would make the rebuild impossible.
model ExecutionState {
  executionId              String   @id
  workspaceId              String
  lifecycleState           String
  governanceState          String
  projectedThroughSequence Int      @default(0)
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id])

  @@index([workspaceId])
  @@map("execution_state")
}

/// Frozen agent identity. Renaming a descriptor later must not rewrite history.
model AgentIdentitySnapshot {
  id                  String   @id @default(uuid())
  workspaceId         String
  executionId         String
  descriptorRef       String
  principalSnapshotId String
  provider            String
  model               String
  adapter             String
  agentVersion        String?
  capabilities        String[]
  createdAt           DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id])

  @@index([workspaceId, executionId])
  @@map("agent_identity_snapshots")
}

/// Phase-aware traceability: input at registration, output at successful
/// completion. A failed execution legitimately has no output row.
model ExecutionTargetBinding {
  id             String   @id @default(uuid())
  workspaceId    String
  executionId    String
  phase          String
  targetType     String
  targetId       String
  targetVersion  Int?
  baselineId     String?
  repositoryId   String?
  branch         String?
  worktree       String?
  commitSha      String?
  artifactDigest String?
  createdAt      DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id])

  @@unique([executionId, phase])
  @@index([workspaceId])
  @@map("execution_target_bindings")
}

model ExecutionArtifact {
  id          String   @id @default(uuid())
  workspaceId String
  executionId String
  role        String
  reference   String
  digest      String?
  evidenceId  String?
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id])

  @@index([workspaceId, executionId])
  @@map("execution_artifacts")
}

/// Append-only thread. A correction is a NEW comment; a redaction is an event
/// plus a flag on a new row -- the body is never overwritten in place.
model ExecutionComment {
  id                      String    @id @default(uuid())
  workspaceId             String
  executionId             String
  authorId                String
  authorType              String
  agentIdentitySnapshotId String?
  commentType             String
  body                    String
  parentCommentId         String?
  visibilityScope         String    @default("workspace")
  mentions                String[]
  attachments             String[]
  evidenceRefs            String[]
  actionRequired          Boolean   @default(false)
  decisionRequired        Boolean   @default(false)
  supersedesCommentId     String?
  integrityHash           String
  redactionState          String    @default("visible")
  redactedBy              String?
  redactedAt              DateTime?
  redactionReason         String?
  createdAt               DateTime  @default(now())

  execution Execution @relation(fields: [executionId], references: [id])

  @@index([workspaceId, executionId])
  @@map("execution_comments")
}

/// The REQUEST. There is deliberately no adjudication column anywhere in this
/// model -- a mutable verdict field would become the audit authority by
/// accident, and the verdict belongs to EPIC-030's stream.
model StatusTransitionProposal {
  id                    String   @id @default(uuid())
  workspaceId           String
  executionId           String
  targetRef             String
  targetVersion         Int
  expectedCurrentStatus String
  proposedState         String
  rationale             String
  proposedBy            String
  proposerSnapshotId    String
  correlationId         String
  idempotencyKey        String
  proposedAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  execution Execution              @relation(fields: [executionId], references: [id])
  state     StatusTransitionState?

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, executionId])
  @@map("status_transition_proposals")
}

/// PROJECTION of EPIC-030's verdict stream. Rebuildable, therefore mutable.
model StatusTransitionState {
  proposalId               String   @id
  workspaceId              String
  state                    String
  projectedThroughSequence Int      @default(0)
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  proposal StatusTransitionProposal @relation(fields: [proposalId], references: [id])

  @@index([workspaceId])
  @@map("status_transition_state")
}

/// Connector-side, mirrored server-side for reconciliation reporting. Mutable
/// by design: attempts and lastError change as a retry proceeds.
model ExecutionOutbox {
  id            String    @id @default(uuid())
  workspaceId   String
  executionId   String
  payload       Json
  localSequence Int
  occurredAt    DateTime
  attempts      Int       @default(0)
  lastError     String?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  execution Execution @relation(fields: [executionId], references: [id])

  @@index([workspaceId, executionId])
  @@map("execution_outbox")
}

model OwnershipBackfillRecord {
  id              String   @id @default(uuid())
  workspaceId     String
  artifactType    String
  artifactId      String
  outcome         String
  reason          String
  resolvedOwnerId String?
  createdAt       DateTime @default(now())

  @@unique([workspaceId, artifactType, artifactId])
  @@map("ownership_backfill_records")
}

/// T1134 (EPIC-028, C3B) -- a registered execution surface. NOT an actor: the
/// same agent can act through several connectors, and a connector proposes
/// nothing on its own.
model ConnectorRegistration {
  id                 String   @id @default(uuid())
  workspaceId        String
  kind               String
  registeredByUserId String
  state              String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  principals Principal[]

  @@index([workspaceId])
  @@map("connector_registrations")
}

/// T1134 -- an agent or service principal. Humans are NOT here: a human
/// principal is a `User`, and a second answer to "who is this person" is
/// exactly the ambiguity this registry exists to remove.
model Principal {
  id                      String   @id @default(uuid())
  workspaceId             String
  kind                    String
  descriptorRef           String
  sponsorUserId           String
  registeredByUserId      String
  state                   String   @default("active")
  identityVersion         Int      @default(1)
  connectorRegistrationId String?
  correlationId           String
  causationId             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id])
  connector   ConnectorRegistration? @relation(fields: [connectorRegistrationId], references: [id])
  stateEvents PrincipalStateEvent[]
  delegations PrincipalDelegation[]

  @@index([workspaceId])
  @@index([sponsorUserId])
  @@map("principals")
}

/// T1134 -- why a principal's state changed. Append-only.
model PrincipalStateEvent {
  id              String   @id @default(uuid())
  workspaceId     String
  principalId     String
  fromState       String?
  toState         String
  identityVersion Int
  actorUserId     String
  reason          String
  correlationId   String
  causationId     String
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  principal Principal @relation(fields: [principalId], references: [id])

  @@index([workspaceId, principalId])
  @@map("principal_state_events")
}

/// T1135 -- frozen identity. What separation of duties compares, and why a
/// revocation cannot rewrite who acted last week. Append-only.
model PrincipalIdentitySnapshot {
  id                      String   @id @default(uuid())
  workspaceId             String
  principalId             String
  kind                    String
  sponsorUserId           String?
  identityVersion         Int
  connectorRegistrationId String?
  capturedAt              DateTime @default(now())
  createdAt               DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, principalId])
  @@map("principal_identity_snapshots")
}

/// T1139 (EPIC-024, C3B) -- scoped, expiring delegation from a sponsoring human
/// to one non-human principal. A sponsor's ownership does NOT flow to every
/// agent they sponsor; approval and application can never be delegated.
model PrincipalDelegation {
  id              String    @id @default(uuid())
  workspaceId     String
  principalId     String
  sponsorUserId   String
  artifactType    String
  artifactId      String
  actions         String[]
  identityVersion Int
  effectiveFrom   DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedById     String?
  correlationId   String
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  principal Principal @relation(fields: [principalId], references: [id])

  @@index([workspaceId, principalId, artifactType, artifactId])
  @@map("principal_delegations")
}

model ApplicationIntent {
  id              String   @id @default(uuid())
  workspaceId     String
  intentId        String
  phase           String
  specificationId String
  expectedStatus  String
  requestedStatus String
  actorId         String
  outcome         String?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, intentId])
  @@index([workspaceId, specificationId])
  @@map("application_intents")
}

/// EPIC-032 (scoped) T1203 — Evidence Contracts and typed evidence.
/// The seam DEF-033-002 found unbound between the Room and an approved baseline.
model EvidenceContract {
  id                    String                 @id @default(uuid())
  workspaceId           String
  projectId             String
  /// FR-EVS-023 — work is judged against the version it began under.
  version               Int                    @default(1)
  /// FR-EVS-026 — only policy may declare a work class needs no evidence.
  declaredEmptyByPolicy Boolean                @default(false)
  createdAt             DateTime               @default(now())
  items                 EvidenceContractItem[]

  @@index([workspaceId])
  @@map("evidence_contracts")
}

model EvidenceContractItem {
  id            String           @id @default(uuid())
  /// FR-002 — tenant-scoped tables carry their workspace; a join is not isolation.
  workspaceId   String
  contractId    String
  description   String
  /// FR-EVS-025 — an item states which evidence types satisfy it.
  acceptedTypes String[]
  createdAt     DateTime         @default(now())
  contract      EvidenceContract @relation(fields: [contractId], references: [id])
  evidence      EvidenceItem[]

  @@index([contractId])
  @@index([workspaceId])
  @@map("evidence_contract_items")
}

model EvidenceItem {
  id                     String               @id @default(uuid())
  workspaceId            String
  /// FR-EVS-003 — typed by what it proves, not by which tool produced it.
  type                   String
  satisfiesItemId        String
  attestsArtifactId      String
  /// FR-EVS-011 — the version, so FR-EVS-012 can refuse superseded evidence.
  attestsArtifactVersion Int
  source                 String
  producedAt             DateTime
  /// FR-EVS-034 — presence is not validity. Defaults to NOT valid.
  integrityValid         Boolean              @default(false)
  /// FR-EVS-014 — a referenced target that still resolves.
  resolvable             Boolean              @default(true)
  createdAt              DateTime             @default(now())
  item                   EvidenceContractItem @relation(fields: [satisfiesItemId], references: [id])

  @@index([satisfiesItemId])
  @@index([workspaceId])
  @@index([workspaceId, attestsArtifactId, attestsArtifactVersion])
  @@map("evidence_items")
}

/// EPIC-034 T406r — the Change Room. RULE-02's gate: no approved baseline
/// changes without passing through here.
model ChangeRequest {
  id                    String              @id @default(uuid())
  workspaceId           String
  projectId             String
  roomObjectId          String
  targetBaselineId      String
  /// FR-CHR-010 — a change is always AGAINST a baseline.
  targetBaselineVersion Int
  requestedOutcome      String
  reason                String
  requester             String
  /// FR-CHR-021 — recorded, never a gate bypass.
  urgency               String              @default("normal")
  openQuestions         Json                @default("[]")
  origin                String              @default("direct")
  originDefectRef       String?
  /// FR-CHR-012, R-034-6 — ids into EPIC-032 and EPIC-035, never copies.
  transferredEvidenceRefs Json              @default("[]")
  transferredContextRefs  Json              @default("[]")
  state                 String              @default("open")
  rebasedFrom           Int?
  createdAt             DateTime            @default(now())
  impactViews           ChangeImpactView[]
  decisions             ChangeDecision[]
  closures              ChangeClosure[]

  @@index([workspaceId])
  @@index([roomObjectId])
  @@map("change_requests")
}

model ChangeImpactView {
  id                  String              @id @default(uuid())
  workspaceId         String
  changeRequestId     String
  computedAt          DateTime
  /// Adopted from EPIC-020's DEFAULT_IMPACT_DEPTH; never chosen here.
  traversalDepth      Int
  retainedForDecision Boolean             @default(false)
  /// FR-CHR-033 — NULL is undeterminable; [] is read-and-none-reached.
  architectureDecisions Json?
  architectureDetail    String
  /// FR-CHR-034 — one value, CHECKed. BR-0073 is U-17 and unowned.
  violationCheckStatus  String
  violationCheckBecause String
  createdAt           DateTime            @default(now())
  request             ChangeRequest       @relation(fields: [changeRequestId], references: [id])
  areas               ChangeImpactArea[]
  decisions           ChangeDecision[]

  @@index([workspaceId])
  @@index([changeRequestId])
  @@map("change_impact_views")
}

model ChangeImpactArea {
  id            String           @id @default(uuid())
  workspaceId   String
  impactViewId  String
  area          String
  state         String
  detail        String
  /// NULL when nobody counted. Zero is a count; NULL is the absence of one.
  itemCount     Int?
  /// Required exactly when the state is `unknown`.
  unknownReason String?
  createdAt     DateTime         @default(now())
  view          ChangeImpactView @relation(fields: [impactViewId], references: [id])

  @@index([workspaceId])
  @@index([impactViewId])
  @@map("change_impact_areas")
}

model ChangeDecision {
  id              String                   @id @default(uuid())
  workspaceId     String
  changeRequestId String
  decidedBy       String
  /// The belt beside EPIC-031's braces — baseline change is permanently high band.
  decidedByKind   String
  authorityBasis  String
  objectVersion   Int
  decidedAt       DateTime
  decisionId      String
  chosenOption    String
  /// FR-CHR-043 — what was NOT chosen travels with the decision.
  declinedOptions Json
  rationale       String
  /// FR-CHR-035 — the snapshot the decision was made against.
  impactViewId    String
  createdAt       DateTime                 @default(now())
  request         ChangeRequest            @relation(fields: [changeRequestId], references: [id])
  impactView      ChangeImpactView         @relation(fields: [impactViewId], references: [id])
  deltas          ChangeBaselineDelta[]
  obligations     ChangeReplanObligation[]

  @@index([workspaceId])
  @@index([changeRequestId])
  @@map("change_decisions")
}

model ChangeBaselineDelta {
  id                  String         @id @default(uuid())
  workspaceId         String
  changeDecisionId    String
  fromBaselineVersion Int
  toBaselineVersion   Int
  /// R-034-4 — member requirement VERSION ids, never requirement text.
  added               Json           @default("[]")
  removed             Json           @default("[]")
  versionChanged      Json           @default("[]")
  createdAt           DateTime       @default(now())
  decision            ChangeDecision @relation(fields: [changeDecisionId], references: [id])

  @@index([workspaceId])
  @@map("change_baseline_deltas")
}

model ChangeReplanObligation {
  id                      String         @id @default(uuid())
  workspaceId             String
  changeDecisionId        String
  affectedSpecificationId String
  whatMustChange          String
  why                     String
  /// R-034-2 — recorded, never executed. U-12 discharges it.
  state                   String         @default("recorded")
  createdAt               DateTime       @default(now())
  decision                ChangeDecision @relation(fields: [changeDecisionId], references: [id])

  @@index([workspaceId])
  @@map("change_replan_obligations")
}

model ChangeClosure {
  id              String        @id @default(uuid())
  workspaceId     String
  changeRequestId String
  /// BR-0048 — what changed, why, and what proves it.
  whatChanged     String
  why             String
  evidenceRefs    Json          @default("[]")
  /// BR-0048's fourth question — which baseline supersedes the old state.
  supersedingBaselineId      String
  supersedingBaselineVersion Int
  closedBy        String
  closedAt        DateTime
  createdAt       DateTime      @default(now())
  request         ChangeRequest @relation(fields: [changeRequestId], references: [id])

  @@index([workspaceId])
  @@map("change_closures")
}

// ─────────────────────────────────────────────────────── EPIC-035 Defect Room
// T997s. Eight tables per specs/035-defect-room/data-model.md §1–§8.
//
// Two CHECK constraints live in the hand-edited migration rather than here,
// because Prisma's schema language cannot express CHECK: a fix cannot be
// accepted for an automatable defect with no failing test (FR-DFR-041), and a
// Classification cannot exist without the destination its outcome maps to
// (FR-DFR-077).

model DefectRecord {
  id                       String           @id @default(uuid())
  workspaceId              String
  projectId                String
  /// FR-DFR-012 — nullable, and that is not laxity: an unlinkable defect is
  /// HELD FOR TRIAGE rather than filed against an Epic somebody guessed.
  epicId                   String?
  state                    String           @default("held-for-triage")
  origin                   String
  originDetail             String?
  contestedArtifactRef     String
  /// FR-DFR-024, PP-012 — a defect is against a VERSION. Without this the
  /// report silently re-targets whatever is current.
  contestedArtifactVersion String
  severity                 String
  reportedBy               String
  reportedAt               DateTime         @default(now())
  withdrawnAt              DateTime?
  withdrawnReason          String?
  createdAt                DateTime         @default(now())
  classifications          Classification[]
  reproductions            Reproduction[]
  tests                    DefectTest[]
  evidenceChecks           EvidenceCheck[]
  repairLinks              RepairLink[]
  routings                 Routing[]
  escapeRecord             EscapeRecord?

  @@index([workspaceId])
  @@index([projectId])
  @@map("defect_records")
}

model Classification {
  id                           String       @id @default(uuid())
  workspaceId                  String
  defectId                     String
  /// FR-DFR-022 — three outcomes, never two.
  outcome                      String
  /// FR-DFR-077 — NOT NULL, and CHECKed against the outcome's mapped value.
  destination                  String
  /// Nullable only when outcome = 'requirement-gap' — CHECKed.
  approvedBehaviourRef         String?
  /// FR-DFR-021 — the absence is recorded rather than left blank.
  absenceRecorded              Boolean      @default(false)
  classifiedBy                 String
  classifiedByKind             String
  /// FR-DFR-023 — an agent may propose; the confirming actor must be human.
  proposedByAgent              Boolean      @default(false)
  supersededByClassificationId String?
  reclassifiedAt               DateTime?
  /// FR-DFR-024 — NULL means the version reported on the defect. A value means
  /// this classification deliberately judged a later one, which is the only
  /// place that fact lives.
  evaluatedAgainstVersion      String?
  rationale                    String
  createdAt                    DateTime     @default(now())
  defect                       DefectRecord @relation(fields: [defectId], references: [id])

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_classifications")
}

model Reproduction {
  id                   String       @id @default(uuid())
  workspaceId          String
  defectId             String
  /// FR-DFR-031 — intermittent is a member, not a flag beside a boolean.
  reproducible         String
  environment          String
  steps                String
  /// FR-DFR-032 — references into EPIC-032. No payload is stored here.
  evidenceRefs         Json         @default("[]")
  /// FR-DFR-043 — required when reproducible = 'not-automatable', CHECKed, so
  /// the exception is enumerable rather than invisible.
  notAutomatableReason String?
  affectedBehaviour    String
  observedAt           DateTime     @default(now())
  createdAt            DateTime     @default(now())
  defect               DefectRecord @relation(fields: [defectId], references: [id])

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_reproductions")
}

model DefectTest {
  id                     String          @id @default(uuid())
  workspaceId            String
  defectId               String
  testRef                String
  /// FR-DFR-042 — linked to the behaviour, not only to the defect.
  contestedBehaviourRef  String
  /// FR-DFR-040 — NOT NULL. A test never seen to fail proves the code does
  /// what it does.
  firstObservedFailingAt DateTime
  lastRunOutcome         String          @default("not-run")
  lastRunEvidenceRef     String?
  createdAt              DateTime        @default(now())
  defect                 DefectRecord    @relation(fields: [defectId], references: [id])
  evidenceChecks         EvidenceCheck[]
  repairLinks            RepairLink[]

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_tests")
}

model EvidenceCheck {
  id           String       @id @default(uuid())
  workspaceId  String
  defectId     String
  defectTestId String
  /// R-035-6 — required, no default. A path taken by omission is a decision
  /// nobody made.
  path         String
  resolvedBy   String
  resolvedAt   DateTime     @default(now())
  rationale    String
  createdAt    DateTime     @default(now())
  defect       DefectRecord @relation(fields: [defectId], references: [id])
  test         DefectTest   @relation(fields: [defectTestId], references: [id])

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_evidence_checks")
}

model RepairLink {
  id                         String       @id @default(uuid())
  workspaceId                String
  defectId                   String
  defectTestId               String
  /// R-035-3 — EPIC-012's TaskRecord is NOT modified. The link lives here.
  taskId                     String
  /// Set when the defect is reclassified after tasks exist, so the tasks and
  /// the reclassification are both visible rather than one erasing the other.
  orphanedByClassificationId String?
  createdAt                  DateTime     @default(now())
  defect                     DefectRecord @relation(fields: [defectId], references: [id])
  test                       DefectTest   @relation(fields: [defectTestId], references: [id])

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_repair_links")
}

model Routing {
  id                  String       @id @default(uuid())
  workspaceId         String
  defectId            String
  classificationId    String
  /// 'repair' needs no routing row — it stays here.
  destination         String
  /// FR-DFR-072, UX-0034 — NOT NULL. "An unexplained transfer button is a
  /// reclassification nobody decided."
  offeredReason       String
  state               String       @default("offered")
  declinedAt          DateTime?
  declinedReason      String?
  /// FR-DFR-074 — an item the destination refuses returns carrying the refusal.
  refusalDetail       String?
  /// FR-DFR-071, FR-DFR-076 — references, never copies.
  carriedEvidenceRefs Json         @default("[]")
  targetRef           String?
  createdAt           DateTime     @default(now())
  defect              DefectRecord @relation(fields: [defectId], references: [id])

  @@index([workspaceId])
  @@index([defectId])
  @@map("defect_routings")
}

model EscapeRecord {
  id                        String       @id @default(uuid())
  workspaceId               String
  defectId                  String       @unique
  origin                    String
  /// Nullable — but the ROW is not. FR-DFR-082: written at intake, so the
  /// first quarter of data is not lost waiting for closure.
  escapePoint               String?
  severity                  String
  affectedRequirementRef    String?
  affectedSpecificationRef  String?
  resolutionEvidenceRef     String?
  /// The DOMAIN fact — when the escape data was taken (FR-DFR-082, at intake).
  capturedAt                DateTime     @default(now())
  /// The ROW's own, required of every table by FR-002. They coincide today.
  createdAt                 DateTime     @default(now())
  defect                    DefectRecord @relation(fields: [defectId], references: [id])

  @@index([workspaceId])
  @@map("defect_escape_records")
}

// ─── EPIC-038 Engineering Context (T1231, T1235) ────────────────────────────

model ContextPackage {
  id               String            @id @default(uuid())
  workspaceId      String
  projectId        String
  /// FR-CTX-062 — the execution this fed. Null only while assembly is in flight.
  executionId      String?
  /// FR-CTX-032 — what it was assembled for, in the requester's own words.
  objective        String
  actorId          String
  actorRole        String
  budgetTokens     Int
  budgetCost       Decimal           @db.Decimal(12, 4)
  state            String
  /// FR-CTX-065 — required when refused, CHECKed. A refusal is a row.
  refusalReason    String?
  /// R-038-4 — which model ranked these candidates.
  embeddingModelId String
  assembledAt      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  items            ContextItem[]
  exclusions       ContextExclusion[]

  @@index([workspaceId])
  @@index([executionId])
  @@map("context_packages")
}

model ContextItem {
  id                  String         @id @default(uuid())
  /// FR-002 — denormalised from the package so isolation is a predicate rather
  /// than a join somebody must remember.
  workspaceId         String
  packageId           String
  /// FR-CTX-041 — a reference. There is deliberately no content column.
  sourceType          String
  sourceId            String
  sourceVersion       String
  /// FR-CTX-042 — required, no default; CHECKed against three values.
  authoritativeStatus String
  supersededBy        String?
  undeterminedReason  String?
  /// FR-CTX-064, PP-016 — the objective term or rule that selected it.
  inclusionReason     String
  /// FR-CTX-014 — the score that ranked it.
  relevanceScore      Float
  crossBoundary       Boolean        @default(false)
  authorisationRef    String?
  createdAt           DateTime       @default(now())
  package             ContextPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([packageId])
  @@map("context_items")
}

model ContextExclusion {
  id           String         @id @default(uuid())
  /// FR-002, as above.
  workspaceId  String
  packageId    String
  sourceType   String
  sourceId     String
  /// Five, closed, no default — a reason by omission cannot be explained.
  reason       String
  detail       String
  /// FR-CTX-039 — so the refusal it caused is explainable after the fact.
  wasEssential Boolean        @default(false)
  createdAt    DateTime       @default(now())
  package      ContextPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([packageId])
  @@map("context_exclusions")
}

model ContextSourceClass {
  id                     String   @id @default(uuid())
  workspaceId            String
  sourceType             String
  securityClassification String
  /// FR-CTX-034 — defaults to false. An unclassified source is excluded.
  indexable              Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@unique([workspaceId, sourceType])
  @@index([workspaceId])
  @@map("context_source_classes")
}

model ContextReusableAuthorisation {
  id              String   @id @default(uuid())
  sourceType      String
  sourceId        String
  /// FR-002 — the row belongs to the workspace that grants the crossing.
  /// Directional: A may read B's handbook does not imply the reverse.
  workspaceId     String
  toWorkspaceId   String
  authorisedBy    String
  authorisedAt    DateTime @default(now())
  rationale       String
  createdAt       DateTime @default(now())

  @@index([workspaceId])
  @@map("context_reusable_authorisations")
}

/// R-038-2 — PARTITIONED BY LIST (workspaceId) in the migration, which Prisma
/// Schema Language cannot express. The `embedding vector` column is likewise
/// absent here and written through raw SQL: Prisma has no vector type, and
/// modelling it as Unsupported would put a column in the client that no query
/// may safely select.
model ContextIndexEntry {
  id               String   @id @default(uuid())
  workspaceId      String
  sourceType       String
  sourceId         String
  /// FR-CTX-016 — staleness is a version comparison, never a timestamp.
  sourceVersion    String
  embeddingModelId String
  dimension        Int
  indexedAt        DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, sourceType, sourceId])
  @@index([embeddingModelId])
  @@map("context_index_entries")
}
