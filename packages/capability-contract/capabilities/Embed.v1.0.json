{
  "name": "Embed",
  "major": 1,
  "minor": 0,
  "scope": "deployment",
  "changesState": false,
  "description": "Turn an ordered batch of texts into one vector per text, of the dimension the bound adapter declares, with the model's id and version.",
  "requiredScope": {
    "access": "read",
    "resources": [
      "model.embed"
    ]
  },
  "errorCategories": [
    "adapter-fault",
    "provider-throttled",
    "provider-unavailable",
    "credential-rejected",
    "not-found",
    "timed-out",
    "batch-too-large",
    "text-too-long",
    "model-not-present",
    "credential-material-in-content"
  ],
  "limits": {
    "maxTexts": 64,
    "maxTextLength": 8000
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "texts"
    ],
    "properties": {
      "texts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "vectors"
    ],
    "properties": {
      "model": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "dimension"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "integer"
          }
        }
      },
      "vectors": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
