{
  "name": "@pmi/mcp-server",
  "version": "0.1.0",
  "description": "pmi-studio — the stdio MCP binding of the PMI Studio execution contract (EPIC-043). A REST client of the platform; holds no business rule.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pmi-studio": "./bin/pmi-studio.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pmi/execution-registry-contract": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
