{
  "name": "pmi-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project backend-unit --project worker-unit --project engine-contract --project observability --project fixture-adapter --project speckit-adapter --project storage-adapters --project execution-contract --project agent-contract --project loop-contract --project decision-contract --project evidence-contract --project room-contract --project agent-adapters --project execution-providers --project scripts --project frontend --project workspace-bundle --project epic-stage --project mcp-server",
    "test:contract": "vitest run --project backend-contract --passWithNoTests",
    "test:integration": "vitest run --project backend-integration",
    "test:arch": "vitest run --project architecture",
    "test:arch:gated": "vitest run --project architecture --exclude \"**/defect-room-transcript.spec.ts\" --exclude \"**/context-transcript.spec.ts\" --exclude \"**/decision-inbox-transcript.spec.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:governance": "vitest run --project governance",
    "test:governance:gated": "vitest run --project governance --exclude \"**/accessibility-record.spec.ts\"",
    "test:known-red": "node scripts/known-red.mjs",
    "register:build": "node scripts/build-register.mjs",
    "typecheck:governance": "tsc -p tests/governance/tsconfig.json",
    "v6:real-run": "tsx --env-file-if-exists=.env scripts/v6-real-run.mjs",
    "register:update": "node scripts/update-register.mjs"
  },
  "devDependencies": {
    "@pmi/epic-stage": "workspace:*",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
