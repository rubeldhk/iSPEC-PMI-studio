# Node / TypeScript
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Environment & secrets — never commit AI provider credentials (ADR-0002)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma
backend/prisma/*.db

# Engine sandbox scratch — ephemeral workspaces are never committed
.engine-workspaces/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Claude Code local settings — machine-specific, not shared
.claude/settings.local.json
.claude/settings.local.json.tmp.*
# Project document artifacts — kept on disk, out of git.
# Anchored with a leading slash so only the repo-root directories match;
# nested source directories of the same name (e.g. tests/governance,
# backend/src/modules/governance) are source and stay tracked.
/docs/
/SRS/
/specs/
/adr/
/governance/
